# Configurações de ambiente para a aplicação FluxoVia-API
TICKETS_API_BASE_URL=http://api:8000
AUTH_EMAIL=your_mail@ufrpe.br
AUTH_PASSWORD=your_password
# RabbitMQ configuration
RABBITMQ_URL="amqp://guest:guest@rabbitmq:5672//"
RABBITMQ_QUEUE="tickets_queue"
# Database configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=fluxovia
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=True